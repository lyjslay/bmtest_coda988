LoadBINARY    Z:\home\arena\projects\cv1835\build\cv1835_ddr_init_and_run_bmtest\2_yuv420.yuv PM:0x119000000

; Load elf
data.load.elf Z:\home\arena\projects\cv1835\build\cv1835_ddr_init_and_run_bmtest\bm1882_ASIC_jpeg.elf

