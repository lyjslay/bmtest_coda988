#define SNSR_TEST_CAPTURE_NUM	3

static int sensor_verify_op(void *priv)
{
	pattern_ctx *ctx = (pattern_ctx *)priv;
	struct isp_ctx     *ictx = &m_ispctx[0];
	struct sensor_info *sinf = (struct sensor_info *)ctx->ptn->priv;
	uint64_t    bayer_w_addr[SNSR_TEST_CAPTURE_NUM][2] = {
				{0x112000000, 0x112800000},
				{0x113000000, 0x113800000},
				{0x114000000, 0x114800000}};
	uint64_t    bayer_w_addr_yuv[SNSR_TEST_CAPTURE_NUM][3] = {
				{0x112000000, 0x112800000, 0x113000000},
				{0x113800000, 0x114000000, 0x114800000},
				{0x115000000, 0x115800000, 0x116000000}};

	while(1) {
		uint64_t    bufaddr;
		uint32_t    bufsize;
		uint32_t    tmp = 0, test_mode = 0, value = 0;
		int cnt = 0, err_cnt = 0;

		bm_get_num("Leave test(0), GAIN(1), SGAIN(2), SHS(3), SHSS(4), Burning(5):", test_mode);

		if (!test_mode)
			break;

		bm_get_num("Value:", value);

		/* capture the 1st default frame. */
		/* Polling Vsync */
		writel(0x0a001064, 0xFFF);
		for(;;) {
			if (readl(0x0a001064) & 0xC0)
				break;
		}
		writel(0x0a001064, 0xFFF);

		switch (test_mode) {
		case 1:
			/* set long gain */
			if (sinf->ops && sinf->ops->set_gain)
				sinf->ops->set_gain(sinf, value);
			break;
		case 2:
			/* set short gain */
			if (sinf->ops && sinf->ops->set_sgain)
				sinf->ops->set_sgain(sinf, value);
			break;
		case 3:
			/* Set long shutter */
			if (sinf->ops && sinf->ops->set_shsl)
				sinf->ops->set_shsl(sinf, value);
			break;
		case 4:
			/* Set short shutter */
			if (sinf->ops && sinf->ops->set_shss)
				sinf->ops->set_shss(sinf, value);
			if (strcmp(ctx->ptn->name, "os08a10") == 0) {
				struct sensor_mode *mode = &os08a10_mode[OS08A10_MODE_720P30];

				sinf->shsl.cur = value;
				config_csibdg(mode->total_w,
						mode->total_h+sinf->shsl.cur+23,
						ctx, 1, 0);
#if 0
				/* Set MAC */
				value = (readl(0x0a0c2044) & ~0xFFFF) |
					(value+5+18);
				writel(0x0a0c2044, value);
#endif
			}
			break;
		case 5:
			uartlog("burning %d frame, start!\n", value);
			break;
		default:
			return 0;
		}
		while(cnt<(test_mode==5?value:SNSR_TEST_CAPTURE_NUM)) {
			/* set frame valid*/
			writel(0x0a000014, 1);
			/* polling frame done. */
			for(;;) {
				if (readl(0x0a001064) & 0x3F) {
					uartlog("frm[%d] err 0x%x\n",
							cnt, readl(0x0a001064));
					/* Stop if it is not burnin test.*/
					if (test_mode != 5)
						return -1;
					err_cnt++;
					writel(0x0a001064, 0x3F);
					break;
				}
				if (readl(0x0a070000) & 0x1) {
					writel(0x0a070000, 1);
					break;
				}
			}
			/* Config the dma */
			if (!ictx->is_yuv_sensor) {
				bufaddr = bayer_w_addr[cnt%SNSR_TEST_CAPTURE_NUM][0];
				ispblk_dma_config(ictx, ISP_BLK_ID_DMA0, bufaddr);
				if (ictx->is_hdr_on) {
					bufaddr = bayer_w_addr[cnt%SNSR_TEST_CAPTURE_NUM][1];
					ispblk_dma_config(ictx, ISP_BLK_ID_DMA1, bufaddr);
				}
			} else {
				bufaddr = bayer_w_addr_yuv[cnt%SNSR_TEST_CAPTURE_NUM][0];
				ispblk_dma_config(ictx, ISP_BLK_ID_DMA0, bufaddr);
				bufaddr = bayer_w_addr_yuv[cnt%SNSR_TEST_CAPTURE_NUM][1];
				ispblk_dma_config(ictx, ISP_BLK_ID_DMA1, bufaddr);
				bufaddr = bayer_w_addr_yuv[cnt%SNSR_TEST_CAPTURE_NUM][2];
				ispblk_dma_config(ictx, ISP_BLK_ID_DMA2, bufaddr);
			}
			cnt++;
		}
		/* restore the dma */
		if (!ictx->is_yuv_sensor) {
			bufaddr = 0x111000000;
			bufsize = VIP_ALIGN((ictx->src_width*12)/8) * ictx->src_height;
			uartlog("csi_bdg to dram 0x%lx size(%#x)\n", bufaddr, bufsize);
			ispblk_dma_config(ictx, ISP_BLK_ID_DMA0, bufaddr);
			if (ictx->is_hdr_on) {
				bufaddr = 0x111800000;
				ispblk_dma_config(ictx, ISP_BLK_ID_DMA1, bufaddr);
				uartlog("se csi_bdg to dram 0x%lx size(%#x)\n", bufaddr, bufsize);
			}
			for (cnt=0; cnt<SNSR_TEST_CAPTURE_NUM-1; cnt++) {
				bufaddr = bayer_w_addr[cnt][0];
				uartlog("csi_bdg to dram 0x%lx size(%#x)\n", bufaddr, bufsize);
				if (ictx->is_hdr_on) {
					bufaddr = bayer_w_addr[cnt][1];
					uartlog("se csi_bdg to dram 0x%lx size(%#x)\n", bufaddr, bufsize);
				}
			}
			if (test_mode == 5)
				uartlog("%d error(s) in %d frame\n", err_cnt, value);
		}
	}

	uartlog("%s done\n", __func__);
	return 0;

}

int config_csibdg(uint32_t width, uint32_t height,
		pattern_ctx *ctx, uint8_t hdr, uint8_t yuv_sensor)
{
	struct isp_ctx     *ictx = &m_ispctx[0];
	uint32_t    bufsize;
	uint64_t    bufaddr;
	uint64_t    bayer_w_addr[3] = {0x111000000, 0x111800000, 0x112000000};

	uartlog("%s configure csibdg-preraw-isptop\n", __func__);

	ictx->src_width = width;//800;
	ictx->src_height = height;//600;

	ictx->phys_regs = ctx->phys_regs;

	ictx->rgb_color_mode = 2;
	ictx->csibdg_patgen_en = 0;
	ictx->sensor_bitdepth = (!!yuv_sensor)?8:12;

	ictx->cam_id = 0;
	ictx->is_yuv_sensor = !!yuv_sensor;
	ictx->is_hdr_on = !!hdr;
	ictx->is_offline_preraw = 0;
	ictx->is_offline_postraw = 1;
	ictx->is_offline_scaler = 1;
	ictx->vreg_page_idx = 0;

	ispblk_preraw_config(ictx);
	ispblk_isptop_config(ictx);
	ispblk_csibdg_config(ictx);

	bufaddr = bayer_w_addr[0];
	ispblk_dma_config(ictx, ISP_BLK_ID_DMA0, bufaddr);

	ispblk_dma_enable(ictx, ISP_BLK_ID_DMA0, 1);

	if (ictx->is_hdr_on) {
		bufsize = VIP_ALIGN((ictx->src_width*12)/8) * ictx->src_height;
		uartlog("csi_bdg to dram 0x%lx size(%#x)\n", bufaddr, bufsize);
		memset((void*)bufaddr, 0x08, bufsize);
		bufaddr = bayer_w_addr[1];
		ispblk_dma_config(ictx, ISP_BLK_ID_DMA1, bufaddr);
		ispblk_dma_enable(ictx, ISP_BLK_ID_DMA1, 1);
		uartlog("se csi_bdg to dram 0x%lx size(%#x)\n", bufaddr, bufsize);
		memset((void*)bufaddr, 0x08, bufsize);
	} else if (ictx->is_yuv_sensor) {
		bufsize = VIP_ALIGN(ictx->src_width) * ictx->src_height;
		uartlog("csi_bdg to dram 0x%lx size(%#x)\n", bufaddr, bufsize);
		memset((void*)bufaddr, 0x08, bufsize);
		bufaddr = bayer_w_addr[1];
		ispblk_dma_config(ictx, ISP_BLK_ID_DMA1, bufaddr);
		ispblk_dma_enable(ictx, ISP_BLK_ID_DMA1, 1);
		uartlog("cb csi_bdg to dram 0x%lx size(%#x)\n", bufaddr, bufsize>>1);
		memset((void*)bufaddr, 0x08, bufsize);
		bufaddr = bayer_w_addr[2];
		ispblk_dma_config(ictx, ISP_BLK_ID_DMA2, bufaddr);
		ispblk_dma_enable(ictx, ISP_BLK_ID_DMA2, 1);
		uartlog("cr csi_bdg to dram 0x%lx size(%#x)\n", bufaddr, bufsize>>1);
		memset((void*)bufaddr, 0x08, bufsize);
	} else {
		bufsize = VIP_ALIGN((ictx->src_width*12)/8) * ictx->src_height;
		uartlog("csi_bdg to dram 0x%lx size(%#x)\n", bufaddr, bufsize);
		memset((void*)bufaddr, 0x08, bufsize);
	}

	isp_streaming(ictx, 1);

	return 0;
}

int list_sensor(void)
{
	int i;

	uartlog("=======================================\n");
	uartlog("            Sensor List\n");
	uartlog("=======================================\n");
	for (i = 0; i < ARRAY_SIZE(pattern_db); ++i) {
		if (pattern_db[i].config_op == NULL)
			break;

		uartlog("%02d. %s\n", i, pattern_db[i].name);
	}
	uartlog("---------------------------------------\n");

	return 0;
}

pattern_ctx* get_sensor_ctx(void)
{
	return &m_ptn_ctx;
}

pattern_ctx* create_sensor_ctx(int case_num)
{
	if ((case_num >= ARRAY_SIZE(pattern_db)) || (pattern_db[case_num].config_op == NULL)) {
		uartlog("%s:%d: error: invalid input %d\n", __func__, __LINE__, case_num);
		return NULL;
	}

	m_ptn_ctx.phys_regs = NULL;
	m_ptn_ctx.mem_base = DRAM_PHY_BASE;
	m_ptn_ctx.vreg_bases = NULL;
	m_ptn_ctx.vreg_bases_pa = NULL;
	m_ptn_ctx.alloc_size = 0;
	m_ptn_ctx.alloc_cnt = 0;

	m_ptn_ctx.ptn = &pattern_db[case_num];

	return &m_ptn_ctx;
}

void destroy_sensor_ctx(pattern_ctx *ctx)
{
	PTN_FREE_ALL(ctx);
}

#define IMX290_TEST_PATTERN_REG        0x308C
#define IMX290_TEST_PTN_V_COLORBAR     0x21

struct sensor_setting imx290_init_720p60_4lane[] = {
	{0x3000, 0x01}, // STANDBY
	{SNR_MARKER_DELAY, 3000}, // delay
	{0x3005, 0x00}, // ADBIT 10bit
	{0x3007, 0x10}, // VREVERS, ...
	{0x3009, 0x01}, // Frame rate select 0-30, 1-60
	{0x300A, 0x3C}, // BLKLEVEL
	{0x300C, 0x00}, // WDMODE [0] 0:Normal, 1:DOL, WDSEL [5:4] 1:DOL 2 frames
	{0x300F, 0x00},
	{0x3010, 0x21},
	{0x3012, 0x64},
	{0x3014, 0x16}, // GAIN, 0x2A=>12.6dB TBD
	{0x3016, 0x09},
	{0x3018, 0xEE}, // VMAX[7:0]
	{0x3019, 0x02}, // VMAX[15:8]
	{0x301A, 0x00}, // VMAX[17:16]:=:0x301A[1:0]
