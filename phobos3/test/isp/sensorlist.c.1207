/********************************************************************
 *   APIs to replace bmtest's standard APIs
 ********************************************************************/

static void imx290_get_gain(void *priv, struct sensor_prop *prop)
{
	struct sensor_info *sinf = (struct sensor_info *)priv;

	*prop = sinf->gain;
	sinf->adpt->read(sinf->adpt, sinf->dev, 0x3014, sinf->alen, (uint8_t*)&(prop->cur), 1);

	return;
}

static void imx290_set_gain(void *priv, uint16_t gain)
{
	struct sensor_info *sinf = (struct sensor_info *)priv;

	sinf->adpt->write(sinf->adpt, sinf->dev, 0x3014, sinf->alen, (uint8_t*)&(gain), 1);
	sinf->gain.cur = gain;

	return;
}

static void imx290_get_sgain(void *priv, struct sensor_prop *prop)
{
	struct sensor_info *sinf = (struct sensor_info *)priv;

	*prop = sinf->sgain;
	sinf->adpt->read(sinf->adpt, sinf->dev, 0x30F2, sinf->alen, (uint8_t*)&(prop->cur), 1);

	return;
}

static void imx290_set_sgain(void *priv, uint16_t gain)
{
	struct sensor_info *sinf = (struct sensor_info *)priv;

	sinf->adpt->write(sinf->adpt, sinf->dev, 0x30F2, sinf->alen, (uint8_t*)&(gain), 1);
	sinf->sgain.cur = gain;

	return;
}

static void imx290_get_shsl(void *priv, struct sensor_prop *prop)
{
	struct sensor_info *sinf = (struct sensor_info *)priv;
	const uint16_t addr[][3] = {{0x3020, 0x3021, 0x3022}, {0x3024, 0x3025, 0x3026}};

	*prop = sinf->shsl;
	sinf->adpt->read(sinf->adpt, sinf->dev, addr[sinf->ishdr][0], sinf->alen, (uint8_t*)&(prop->cur), 1);
	sinf->adpt->read(sinf->adpt, sinf->dev, addr[sinf->ishdr][1], sinf->alen, ((uint8_t*)&(prop->cur)) + 1, 1);
	sinf->adpt->read(sinf->adpt, sinf->dev, addr[sinf->ishdr][2], sinf->alen, ((uint8_t*)&(prop->cur)) + 2, 1);

	return;
}

static void imx290_set_shsl(void *priv, uint32_t shs)
{
	struct sensor_info *sinf = (struct sensor_info *)priv;
	const uint16_t addr[][3] = {{0x3020, 0x3021, 0x3022}, {0x3024, 0x3025, 0x3026}};

	sinf->adpt->write(sinf->adpt, sinf->dev, addr[sinf->ishdr][0], sinf->alen, (uint8_t*)&(shs), 1);
	sinf->adpt->write(sinf->adpt, sinf->dev, addr[sinf->ishdr][1], sinf->alen, ((uint8_t*)&(shs)) + 1, 1);
	sinf->adpt->write(sinf->adpt, sinf->dev, addr[sinf->ishdr][2], sinf->alen, ((uint8_t*)&(shs)) + 2, 1);
	sinf->shsl.cur = shs;

	return;
}

static void imx290_get_shss(void *priv, struct sensor_prop *prop)
{
	struct sensor_info *sinf = (struct sensor_info *)priv;

	*prop = sinf->shss;
	sinf->adpt->read(sinf->adpt, sinf->dev, 0x3020, sinf->alen, (uint8_t*)&(prop->cur), 1);
	sinf->adpt->read(sinf->adpt, sinf->dev, 0x3021, sinf->alen, ((uint8_t*)&(prop->cur)) + 1, 1);
	sinf->adpt->read(sinf->adpt, sinf->dev, 0x3022, sinf->alen, ((uint8_t*)&(prop->cur)) + 2, 1);

	return;
}

static void imx290_set_shss(void *priv, uint32_t shs)
{
	struct sensor_info *sinf = (struct sensor_info *)priv;

	sinf->adpt->write(sinf->adpt, sinf->dev, 0x3020, sinf->alen, (uint8_t*)&(shs), 1);
	sinf->adpt->write(sinf->adpt, sinf->dev, 0x3021, sinf->alen, ((uint8_t*)&(shs)) + 1, 1);
	sinf->adpt->write(sinf->adpt, sinf->dev, 0x3022, sinf->alen, ((uint8_t*)&(shs)) + 2, 1);
	sinf->shss.cur = shs;

	return;
}

static struct sensor_ops imx290_ops = {
	.get_gain = imx290_get_gain,
	.set_gain = imx290_set_gain,
	.get_sgain = imx290_get_sgain,
	.set_sgain = imx290_set_sgain,
	.get_shsl = imx290_get_shsl,
	.set_shsl = imx290_set_shsl,
	.get_shss = imx290_get_shss,
	.set_shss = imx290_set_shss,
};

static void os08a10_set_shsl(void *priv, uint32_t shs)
{
	struct sensor_info *sinf = (struct sensor_info *)priv;

	sinf->adpt->write(sinf->adpt, sinf->dev, 0x3502, sinf->alen, (uint8_t*)&(shs), 1);
	sinf->adpt->write(sinf->adpt, sinf->dev, 0x3501, sinf->alen, ((uint8_t*)&(shs)) + 1, 1);
	sinf->shsl.cur = shs;

	return;
}

static void os08a10_set_shss(void *priv, uint32_t shs)
{
	struct sensor_info *sinf = (struct sensor_info *)priv;

	sinf->adpt->write(sinf->adpt, sinf->dev, 0x3512, sinf->alen, (uint8_t*)&(shs), 1);
	sinf->adpt->write(sinf->adpt, sinf->dev, 0x3511, sinf->alen, ((uint8_t*)&(shs)) + 1, 1);
	sinf->shsl.cur = shs;

	return;
}

static void os08a10_set_gain(void *priv, uint16_t gain)
{
	struct sensor_info *sinf = (struct sensor_info *)priv;

	sinf->adpt->write(sinf->adpt, sinf->dev, 0x3509, sinf->alen, (uint8_t*)&(gain), 1);
	sinf->adpt->write(sinf->adpt, sinf->dev, 0x3508, sinf->alen, ((uint8_t*)&(gain)) + 1, 1);
	sinf->gain.cur = gain;

	return;
}

static void os08a10_set_sgain(void *priv, uint16_t gain)
{
	struct sensor_info *sinf = (struct sensor_info *)priv;

	sinf->adpt->write(sinf->adpt, sinf->dev, 0x350D, sinf->alen, (uint8_t*)&(gain), 1);
	sinf->adpt->write(sinf->adpt, sinf->dev, 0x350C, sinf->alen, ((uint8_t*)&(gain)) + 1, 1);
	sinf->shsl.cur = gain;

	return;
}

static struct sensor_ops os08a10_ops = {
	.set_gain = os08a10_set_gain,
	.set_sgain = os08a10_set_sgain,
	.set_shsl = os08a10_set_shsl,
	.set_shss = os08a10_set_shss,
};

static void ar0239_set_shsl(void *priv, uint32_t shs)
{
	struct sensor_info *sinf = (struct sensor_info *)priv;

	shs = ((shs&0xFF)<<8) | ((shs>>8)&0xFF);
	sinf->adpt->write(sinf->adpt, sinf->dev, 0x3012, sinf->alen, (uint8_t*)&(shs), 2);
	sinf->shsl.cur = shs;

	return;
}

static void ar0239_set_gain(void *priv, uint16_t gain)
{
	struct sensor_info *sinf = (struct sensor_info *)priv;
	uint16_t value = 0x0004;

	value = ((value&0xFF)<<8) | ((value>>8)&0xFF);
	gain = ((gain&0xFF)<<8) | ((gain>>8)&0xFF);
	sinf->adpt->write(sinf->adpt, sinf->dev, 0x3100, sinf->alen, (uint8_t*)&(value), 2);
	sinf->adpt->write(sinf->adpt, sinf->dev, 0x3060, sinf->alen, (uint8_t*)&(gain), 2);
	sinf->gain.cur = gain;

	return;
}

static struct sensor_ops ar0239_ops = {
	.set_gain = ar0239_set_gain,
	.set_shsl = ar0239_set_shsl,
};

static void ar0237_set_shsl(void *priv, uint32_t shs)
{
	struct sensor_info *sinf = (struct sensor_info *)priv;

	shs = ((shs&0xFF)<<8) | ((shs>>8)&0xFF);
	sinf->adpt->write(sinf->adpt, sinf->dev, 0x3012, sinf->alen, (uint8_t*)&(shs), 2);
	sinf->shsl.cur = shs;

	return;
}

static void ar0237_set_shss(void *priv, uint32_t shs)
{
	struct sensor_info *sinf = (struct sensor_info *)priv;

	shs = ((shs&0xFF)<<8) | ((shs>>8)&0xFF);
	sinf->adpt->write(sinf->adpt, sinf->dev, 0x3212, sinf->alen, (uint8_t*)&(shs), 2);
	sinf->shsl.cur = shs;

	return;
}

static void ar0237_set_gain(void *priv, uint16_t gain)
{
	struct sensor_info *sinf = (struct sensor_info *)priv;
	const uint16_t addr[2] = {0x3060, 0x312C};
	uint16_t value = sinf->ishdr?0x0504:0x0004;

	value = ((value&0xFF)<<8) | ((value>>8)&0xFF);
	gain = ((gain&0xFF)<<8) | ((gain>>8)&0xFF);
	sinf->adpt->write(sinf->adpt, sinf->dev, 0x3100, sinf->alen, (uint8_t*)&(value), 2);
	sinf->adpt->write(sinf->adpt, sinf->dev, addr[sinf->ishdr], sinf->alen, (uint8_t*)&(gain), 2);
	sinf->gain.cur = gain;

	return;
}

static void ar0237_set_sgain(void *priv, uint16_t gain)
{
	struct sensor_info *sinf = (struct sensor_info *)priv;
	uint16_t value = 0x0504;

	value = ((value&0xFF)<<8) | ((value>>8)&0xFF);
	gain = ((gain&0xFF)<<8) | ((gain>>8)&0xFF);
	sinf->adpt->write(sinf->adpt, sinf->dev, 0x3100, sinf->alen, (uint8_t*)&(value), 2);
	sinf->adpt->write(sinf->adpt, sinf->dev, 0x3060, sinf->alen, (uint8_t*)&(gain), 2);
	sinf->gain.cur = gain;

	return;
}

static struct sensor_ops ar0237_ops = {
	.set_gain = ar0237_set_gain,
	.set_sgain = ar0237_set_sgain,
	.set_shsl = ar0237_set_shsl,
	.set_shss = ar0237_set_shss,
};

static void imx327_get_gain(void *priv, struct sensor_prop *prop)
{
	struct sensor_info *sinf = (struct sensor_info *)priv;

	*prop = sinf->gain;
	sinf->adpt->read(sinf->adpt, sinf->dev, 0x3014, sinf->alen, (uint8_t*)&(prop->cur), 1);

	return;
}

static void imx327_set_gain(void *priv, uint16_t gain)
{
	struct sensor_info *sinf = (struct sensor_info *)priv;

	sinf->adpt->write(sinf->adpt, sinf->dev, 0x3014, sinf->alen, (uint8_t*)&(gain), 1);
	sinf->gain.cur = gain;

	return;
}

static void imx327_get_sgain(void *priv, struct sensor_prop *prop)
{
	struct sensor_info *sinf = (struct sensor_info *)priv;

	*prop = sinf->sgain;
	sinf->adpt->read(sinf->adpt, sinf->dev, 0x30F2, sinf->alen, (uint8_t*)&(prop->cur), 1);

	return;
}

static void imx327_set_sgain(void *priv, uint16_t gain)
{
	struct sensor_info *sinf = (struct sensor_info *)priv;

	sinf->adpt->write(sinf->adpt, sinf->dev, 0x30F2, sinf->alen, (uint8_t*)&(gain), 1);
	sinf->sgain.cur = gain;

	return;
}

static void imx327_get_shsl(void *priv, struct sensor_prop *prop)
{
	struct sensor_info *sinf = (struct sensor_info *)priv;
	const uint16_t addr[][3] = {{0x3020, 0x3021, 0x3022}, {0x3024, 0x3025, 0x3026}};

	*prop = sinf->shsl;
	sinf->adpt->read(sinf->adpt, sinf->dev, addr[sinf->ishdr][0], sinf->alen, (uint8_t*)&(prop->cur), 1);
	sinf->adpt->read(sinf->adpt, sinf->dev, addr[sinf->ishdr][1], sinf->alen, ((uint8_t*)&(prop->cur)) + 1, 1);
	sinf->adpt->read(sinf->adpt, sinf->dev, addr[sinf->ishdr][2], sinf->alen, ((uint8_t*)&(prop->cur)) + 2, 1);

	return;
}

static void imx327_set_shsl(void *priv, uint32_t shs)
{
	struct sensor_info *sinf = (struct sensor_info *)priv;
	const uint16_t addr[][3] = {{0x3020, 0x3021, 0x3022}, {0x3024, 0x3025, 0x3026}};

	sinf->adpt->write(sinf->adpt, sinf->dev, addr[sinf->ishdr][0], sinf->alen, (uint8_t*)&(shs), 1);
	sinf->adpt->write(sinf->adpt, sinf->dev, addr[sinf->ishdr][1], sinf->alen, ((uint8_t*)&(shs)) + 1, 1);
	sinf->adpt->write(sinf->adpt, sinf->dev, addr[sinf->ishdr][2], sinf->alen, ((uint8_t*)&(shs)) + 2, 1);
	sinf->shsl.cur = shs;

	return;
}

static void imx327_get_shss(void *priv, struct sensor_prop *prop)
{
	struct sensor_info *sinf = (struct sensor_info *)priv;

	*prop = sinf->shss;
	sinf->adpt->read(sinf->adpt, sinf->dev, 0x3020, sinf->alen, (uint8_t*)&(prop->cur), 1);
	sinf->adpt->read(sinf->adpt, sinf->dev, 0x3021, sinf->alen, ((uint8_t*)&(prop->cur)) + 1, 1);
	sinf->adpt->read(sinf->adpt, sinf->dev, 0x3022, sinf->alen, ((uint8_t*)&(prop->cur)) + 2, 1);

	return;
}

static void imx327_set_shss(void *priv, uint32_t shs)
{
	struct sensor_info *sinf = (struct sensor_info *)priv;

	sinf->adpt->write(sinf->adpt, sinf->dev, 0x3020, sinf->alen, (uint8_t*)&(shs), 1);
	sinf->adpt->write(sinf->adpt, sinf->dev, 0x3021, sinf->alen, ((uint8_t*)&(shs)) + 1, 1);
	sinf->adpt->write(sinf->adpt, sinf->dev, 0x3022, sinf->alen, ((uint8_t*)&(shs)) + 2, 1);
	sinf->shss.cur = shs;

	return;
}

static struct sensor_ops imx327_ops = {
	.get_gain = imx327_get_gain,
	.set_gain = imx327_set_gain,
	.get_sgain = imx327_get_sgain,
	.set_sgain = imx327_set_sgain,
	.get_shsl = imx327_get_shsl,
	.set_shsl = imx327_set_shsl,
	.get_shss = imx327_get_shss,
	.set_shss = imx327_set_shss,
};

int sensor_get_gain(pattern_entry *ptn, struct sensor_prop *prop)
{
	if (ptn == NULL) {
		uartlog("null sensor ptn\n");
		return -1;
	}

	if (strcmp(ptn->name, "imx290_default") == 0) {
		imx290_get_gain(ptn->priv, prop);
	}

	return 0;
}

int sensor_set_gain(pattern_entry *ptn, uint16_t gain)
{
	if (ptn == NULL) {
		uartlog("null sensor ptn\n");
		return -1;
	}

	struct sensor_prop prop;
	if (strcmp(ptn->name, "imx290_default") == 0) {
		imx290_get_gain(ptn->priv, &prop);
		if (gain > prop.max || gain < prop.min)
			return -1;
		imx290_set_gain(ptn->priv, gain);
	}
	return 0;
}

