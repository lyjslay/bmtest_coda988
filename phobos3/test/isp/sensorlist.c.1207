static int peri_up_5(void *priv)
{

	char cmdbuf[8];
	unsigned int *fpga_pwr_reg;
	uint32_t value;

	cmdbuf[0] = '0';
	cli_readline("### enter to start power-on seqeuence. s) to skip : ", cmdbuf);
	if (cmdbuf[0] == 's')
		return 0;

	// power down/reset
	// 1.2V = 1, 1.8V = 1, 2.9V = 1
	// INCK on
	// XCLR = 0
	// wait 500ns, wait INCK stable
	// XCLR = 1
	// wait 20us

	// enable display clk select
	value = readl(0x0a0c8018);
	value |= 0x02;
	writel(0x0a0c8018, value);
	udelay(5000);

	// Switch the MAC type to TTL
	writel(0x0a0c2000, 0x00000002);
	// configure TTL [0] ttl enable [2:1] bit mode
	writel(0x0a0c2010, 0x00002421);
	fpga_pwr_reg = (unsigned int *)HARD_REG_FPGA_PWRPIN;
#if 0
	// power sequence
	writel(fpga_pwr_reg, 0);
	uartlog("power-on delay\n");
	udelay(5000);
	writel(fpga_pwr_reg, 0x08);
	uartlog("power-on delay\n");
	udelay(5000);
	writel(fpga_pwr_reg, 0x18);
	uartlog("power-on delay\n");
	udelay(5000);
	writel(fpga_pwr_reg, 0x38);
	uartlog("power-on delay\n");
	udelay(5000);
#endif
	// clear reset and enable phy rx
	writel(fpga_pwr_reg, 0x30100001);
	uartlog("### device poweron\n");

	return 0;
}

static int peri_down_5(void *priv)
{
	char cmdbuf[8] = {0};
	unsigned int *fpga_pwr_reg;

	fpga_pwr_reg = (unsigned int *)HARD_REG_FPGA_PWRPIN;

	cli_readline("### power-off? y/n", cmdbuf);

	if (cmdbuf[0] == 'y') {
		// INCLK = 0
		// XCLR = 0
		// POWER-OFF sequence
		uartlog("power-off");
		writel(fpga_pwr_reg, 0x18);
		udelay(5000);
		writel(fpga_pwr_reg, 0x08);
		udelay(5000);
		writel(fpga_pwr_reg, 0);
		udelay(5000);
	}

	return 0;
}

static int peri_up_6(void *priv)
{

	char cmdbuf[8];
	unsigned int *fpga_pwr_reg;
	uint32_t value;

	cmdbuf[0] = '0';
	cli_readline("### enter to start power-on seqeuence. s) to skip : ", cmdbuf);
	if (cmdbuf[0] == 's')
		return 0;

	// power down/reset
	// 1.2V = 1, 1.8V = 1, 2.9V = 1
	// INCK on
	// XCLR = 0
	// wait 500ns, wait INCK stable
	// XCLR = 1
	// wait 20us

#if 0
	// enable display clk select
	value = readl(0x0a0c8018);
	value |= 0x02;
	writel(0x0a0c8018, value);
	udelay(5000);
#endif

	// Switch the MAC type to MIPI-CSI
	writel(0x0a0c2000, 0x000000F0);
	value = readl(0x0a0c2400);
	// config lane number
	value |= 0x01;
	// config force video format
	// value |= (0x8<<16) | (0x01<<13);
	// Enable SOL
	//value |= (0x1<<12);
	writel(0x0a0c2400, value);
	// config the vs gen mode.
	writel(0x0a0c2470, 0x00);
	fpga_pwr_reg = (unsigned int *)HARD_REG_FPGA_PWRPIN;
#if 0
	// power sequence
	writel(fpga_pwr_reg, 0);
	uartlog("power-on delay\n");
	udelay(5000);
	writel(fpga_pwr_reg, 0x08);
	uartlog("power-on delay\n");
	udelay(5000);
	writel(fpga_pwr_reg, 0x18);
	uartlog("power-on delay\n");
	udelay(5000);
	writel(fpga_pwr_reg, 0x38);
	uartlog("power-on delay\n");
	udelay(5000);
#endif
	// clear reset and enable phy rx
	writel(fpga_pwr_reg, 0x02100000);
	// writel(fpga_pwr_reg, 0x00100000);
	uartlog("### device poweron\n");

	return 0;
}

static int peri_down_6(void *priv)
{
	char cmdbuf[8] = {0};
	unsigned int *fpga_pwr_reg;

	fpga_pwr_reg = (unsigned int *)HARD_REG_FPGA_PWRPIN;

	cli_readline("### power-off? y/n", cmdbuf);

	if (cmdbuf[0] == 'y') {
		// INCLK = 0
		// XCLR = 0
		// POWER-OFF sequence
		uartlog("power-off");
		writel(fpga_pwr_reg, 0x18);
		udelay(5000);
		writel(fpga_pwr_reg, 0x08);
		udelay(5000);
