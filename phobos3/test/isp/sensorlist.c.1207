static int imx290_poweron(void *priv)
{
	pattern_ctx *ctx = (pattern_ctx *)priv;
	struct sensor_info *sinf = (struct sensor_info *)ctx->ptn->priv;
	struct snr_i2c_adapter *adpt = NULL;
	struct sensor_setting *sensor_set = imx290_init_720p60_4lane;
	int setting_num = ARRAY_SIZE(imx290_init_720p60_4lane);
	struct sensor_setting *pset;
	struct sensor_mode *mode = &imx290_mode[IMX290_MODE_720P60];
	char cmdbuf[8];
	int i, r, test_pn = 0;
	uint32_t value;

	if (sensor_mode) {
		switch (sensor_mode) {
		case 1:
			mode = &imx290_mode[IMX290_MODE_720P30];
			sensor_set = imx290_init_720p30_2lane;
			setting_num = ARRAY_SIZE(imx290_init_720p30_2lane);
			uartlog("use 720p30 2 lanes\n");
			sinf->ishdr = false;
			sinf->shsl.min = 1;
			sinf->shsl.max = 0x2EC;
			break;
		case 2:
			mode = &imx290_mode[IMX290_MODE_720P30];
			sensor_set = imx290_init_720p30_4lane;
			setting_num = ARRAY_SIZE(imx290_init_720p30_4lane);
			uartlog("use 720p30 4 lanes\n");
			sinf->ishdr = false;
			sinf->shsl.min = 1;
			sinf->shsl.max = 0x2EC;
			break;
		case 3:
			mode = &imx290_mode[IMX290_MODE_720P15_HDR1];
			sensor_set = imx290_init_720p30_2lane_hdr1;
			setting_num = ARRAY_SIZE(imx290_init_720p30_2lane_hdr1);
			uartlog("use 720p30 2 lanes HDR Pattern 1\n");
			sinf->ishdr = true;
			sinf->shsl.min = IMX290_HDR1_RHS + 2;
			sinf->shsl.max = IMX290_HDR1_VMAX*2 - 2;
			sinf->shss.min = 2;
			sinf->shss.max = IMX290_HDR1_RHS - 2;
			break;
		case 4:
			mode = &imx290_mode[IMX290_MODE_720P15_HDR2];
			sensor_set = imx290_init_720p30_2lane_hdr2;
			setting_num = ARRAY_SIZE(imx290_init_720p30_2lane_hdr2);
			uartlog("use 720p30 2 lanes HDR Pattern 2\n");
			sinf->ishdr = true;
			sinf->shsl.min = IMX290_HDR1_RHS + 2;
			sinf->shsl.max = IMX290_HDR1_VMAX*2 - 2;
			sinf->shss.min = 2;
			sinf->shss.max = IMX290_HDR1_RHS - 2;
			break;
		default:
			uartlog("use 720p60 4 lanes\n");
			break;
		}
	}
	cmdbuf[0] = cmdbuf[1] = '0';
	cli_readline("enable test pattern? [n/y]", cmdbuf);
	if (cmdbuf[0] == 'y') {
		test_pn = 1;
	}
	// i2c config here
	snr_bm_i2c_get_adap((void *)&adpt);
	sinf->adpt = adpt;

	adpt->slaveaddr = sinf->dev;
	snr_bm_i2c_init(adpt);

	// i2c initial sequence
	for (i = 0; i < setting_num; i++) {
		pset = &(sensor_set[i]);

		if (pset->addr == SNR_MARKER_DELAY) {
			uartlog("sensor wr delay\n");
			udelay(pset->val);
			continue;
		}
		if (pset->addr == IMX290_TEST_PATTERN_REG) {
			if (test_pn)
				pset->val = IMX290_TEST_PTN_V_COLORBAR;
			else
				pset->val = 0;
		}
		r = sinf->adpt->write(sinf->adpt, sinf->dev, pset->addr, sinf->alen, (uint8_t*)&(pset->val), 1);
		if (r < 0)
			uartlog("%s i2c_write fail addr[0x%x]\n", ctx->ptn->name, pset->addr);
	}

	uartlog("Read back i2c registers:\n");
	for (i = 0; i < setting_num; i++) {
		uint8_t val[2] = {0xFF};

		pset = &(sensor_set[i]);

		r = sinf->adpt->read(sinf->adpt, sinf->dev, pset->addr, sinf->alen, (uint8_t*)&(val[0]), 1);

		uartlog("reg[0x%x]=0x%x(0x%x)\n", pset->addr, val[0], pset->val);
	}

#if defined(CIF_DPHY_ENABLE)
	// Switch the PHY type to SUBLVDS
	value = readl(0x0300B0F0);
	value &= 0xFFFF0000;
	writel(0x0300B0F0, value);
	value |= 0x37;
	writel(0x0300B0F0, value);
#endif
	uartlog("streaming start\n");

	cmdbuf[0] = cmdbuf[1] = '0';
	cli_readline("run sensor to dram flow? [n/y]", cmdbuf);
	if (cmdbuf[0] == 'y') {
		uartlog("dump %d x %d \n", mode->total_w, mode->total_h);
		config_csibdg(mode->total_w, mode->total_h, ctx,
			      (sensor_mode == 3 || sensor_mode == 4), 0);
	}

	return 0;
}

struct sensor_setting imx078_init_720p[] = {
	{0x00, 0x02}, /* STANDBY */
	{SNR_MARKER_DELAY, 3000}, /* delay >1ms */
	{0x00, 0x00}, /* STANDBY */
	{0x5C, 0x01}, /* DCKRST */
	{0x0A, 0x10}, /* CLPSQRST */
	{SNR_MARKER_DELAY, 1000}, /* delay */
	{0x01, 0x33}, /* STBLVDS, CHSEL */
	{0x02, 0x00}, /* SVR: expo shutdown v period */
	{0x03, 0x00}, /* SVR */
	{0x04, 0x00}, /* SPL: expo start v period */
	{0x05, 0x00}, /* SPL */
	{0x06, 0x20}, /* SHR: expo start h period */
	{0x07, 0x01}, /* SHR */
	{0x08, 0x40}, /* PGC: analog gain */
	{0x09, 0x01}, /* PGC */
	{0x0D, 0x03}, /* Readout mode 7:1/5 elim */
	{0x0E, 0x00}, /* 0: rolling 1: global shutter*/
	{0x0F, 0x10}, /* BLKLEVEL */
	{0x10, 0x01}, /* Digital gain */
	{0x17, 0x00}, /* RDHMD, GSVR */
	/* {0x18, 0x45}, INCK x2/x4 DDR output */
	{0x19, 0x00}, /* ADBIT 9/10/12bits */
	/* {0x4C, 0x70}, PLSTMG04 */
	/* {0x4D, 0x70}, PLSTMG05 */
	{0x69, 0x00}, /* Hor 2/4 elim mode setting */
	/* {0x0330, 0x01}, PLSTMG07 */
	{}
};

static int imx078_poweron(void *priv)
{
	pattern_ctx *ctx = (pattern_ctx *)priv;
	struct sensor_info *sinf = (struct sensor_info *)ctx->ptn->priv;
	struct snr_spi_adapter *adpt = NULL;
	struct sensor_setting *pset;
	int i, r;

	// i2c config here
	adpt = snr_bm_spi_get_adpt(NULL);
	sinf->spi_adpt = adpt;

	adpt->init(adpt, sinf->dev, sinf->alen, 1);

	// i2c initial sequence
	for (i = 0; i < ARRAY_SIZE(imx078_init_720p); i++) {
		pset = &(imx078_init_720p[i]);

		if (pset->addr == SNR_MARKER_DELAY) {
			uartlog("sensor wr delay\n");
			udelay(pset->val);
			continue;
		}
		r = sinf->spi_adpt->write(sinf->spi_adpt, pset->addr, (uint8_t*)&(pset->val), 1);
		uartlog("write reg[0x%x]=0x%x\n", pset->addr, pset->val);
		if (r < 0)
			uartlog("%s i2c_write fail addr[0x%x]\n", ctx->ptn->name, pset->addr);
	}

	uartlog("streaming start\n");

	return 0;
}

static void sensor_data_convert(struct sensor_setting *data, int size)
{
	struct sensor_setting *s;
	int i;

	for (i = 0, s = data; i < size; i++, s++) {
		uint16_t tmp = ((s->val & 0xFF) << 8) | (s->val >> 8);
		s->val = tmp;
	}
}

