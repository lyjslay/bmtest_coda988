;Source Path Setting
SourcePathReset
AddSourcePath F:\jinf\source\bm1880
AddSourcePath F:\jinf\source\bm1880\test\jpeg
AddSourcePath F:\jinf\source\bm1880\test\jpeg\jdi
AddSourcePath F:\jinf\source\bm1880\test\jpeg\jpuapi
AddSourcePath F:\jinf\source\bm1880\test\jpeg\src
SetDirSourcePath F:\jinf\source\bm1880
SetDirSourcePath F:\jinf\source\bm1880\test\jpeg
SetDirSourcePath F:\jinf\source\bm1880\test\jpeg\jdi
SetDirSourcePath F:\jinf\source\bm1880\test\jpeg\jpuapi
SetDirSourcePath F:\jinf\source\bm1880\test\jpeg\src
;OPTION SET END

&app_elf="F:\jinf\bm1880_jpeg.elf"

winclear

winpos 20% 0% 20% 100%
AREA
AREA.Clear

ConnectAttach
break;
;ddr init
print "Initial DDR ..."
;; LoadBinary F:\xunli\scripts\bm1880_ddr_init.bin PM:0x4000000
LoadBinary F:\xunli\cnm\test\bm1880\scripts\bm1880_ddr_init.bin PM:0x4000000
;; LoadBinary F:\jinf\bm1880_ddr_init.bin PM:0x4000000
setPC 0x4000000
GO

wait 1000.ms
break
print "Initial DDR DONE!"

FILEOpen 23 "test.txt" %create ; open file test.txt , if not exist, create it.
FileWrite 23 "####################################"
FileWrite 23 "#   AUTO JPEG TESTING              #"
FileWrite 23 "####################################"
FileWrite 23 ""

